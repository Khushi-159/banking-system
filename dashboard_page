from selenium.webdriver.common.by import By
class DashboardPage:
    def __init__(self, driver):
        self.driver = driver
        self.manager_id = driver.find_element(By.XPATH, "//td[contains(text(),'Manger Id')]")
        self.new_customer_link = driver.find_element(By.LINK_TEXT, "New Customer")
        self.logout_link = driver.find_element(By.LINK_TEXT, "Log out")
